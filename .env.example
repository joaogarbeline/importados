# Banco de dados (usado pelo docker-compose para montar o DATABASE_URL do app)
POSTGRES_USER="triade"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="triade_db"

# Usado apenas fora do docker-compose (ex: rodando `npm run dev` direto na máquina)
DATABASE_URL="postgresql://triade:CHANGE_ME@localhost:5432/triade_db?schema=public"

# App
NEXT_PUBLIC_APP_URL="https://loja.performancetriade.com.br"
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-base64_32"
NEXTAUTH_URL="https://loja.performancetriade.com.br"

# Resend (e-mail transacional) - https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Triade Performance <contato@performancetriade.com.br>"

# Mercado Pago (Checkout Pro) - https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# Usuário admin criado pelo seed (só usado na primeira execução)
ADMIN_EMAIL="contato@performancetriade.com.br"
ADMIN_PASSWORD="CHANGE_ME"
ADMIN_NAME="Triade Sistemas e Importados"
