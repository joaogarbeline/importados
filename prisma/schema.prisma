generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  AGUARDANDO_ESTOQUE
  LIBERADO_PARA_PAGAMENTO
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
  PAGAMENTO_EXPIRADO
}

enum EmailType {
  PEDIDO_CRIADO
  PAGAMENTO_LIBERADO
  PAGAMENTO_CONFIRMADO
  PEDIDO_ENVIADO
  PEDIDO_CANCELADO
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  ESTORNADO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]

  @@index([role])
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String  @default("Principal")
  cep         String
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  images      String[]
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  sku         String   @unique
  barcode     String?  @unique
  stockQty    Int      @default(0)
  isPreOrder  Boolean  @default(true)
  category    String
  active      Boolean  @default(true)

  brand    String?
  model    String?
  color    String?
  capacity String?
  warranty String?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  reviews        Review[]

  @@index([category])
  @@index([active])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  qtyChange Int
  reason    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  shippingAddressId String?
  status            OrderStatus @default(AGUARDANDO_ESTOQUE)
  subtotal          Decimal     @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  releasedAt        DateTime?
  paidAt            DateTime?

  user            User        @relation(fields: [userId], references: [id])
  shippingAddress Address?    @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  emailLogs       EmailLog[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  qty            Int
  unitPrice      Decimal @db.Decimal(10, 2)
  stockAllocated Boolean @default(false)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId, stockAllocated])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  mpPreferenceId String?
  mpPaymentId    String?       @unique
  initPoint      String?
  status         PaymentStatus @default(PENDENTE)
  method         String?
  amount         Decimal       @db.Decimal(10, 2)
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model EmailLog {
  id       String    @id @default(cuid())
  orderId  String?
  type     EmailType
  toEmail  String
  resendId String?
  sentAt   DateTime  @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
}
